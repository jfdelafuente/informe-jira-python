# Datos del proyecto (nueva estructura)
# Ignorar datos generados, pero mantener estructura
data/input/*.csv
data/input/*.xlsx
data/output/*.csv
data/output/*.xlsx
data/json/bugs/*.json
data/json/deliveries/*.json

# Mantener directorios vacíos
!data/input/.gitkeep
!data/output/.gitkeep
!data/json/bugs/.gitkeep
!data/json/deliveries/.gitkeep

# Logs
logs/*.log
logs/*.txt
*.log
*.txt

# Excepciones: Permitir archivos de requirements
!requirements*.txt

# Mantener directorio de logs
!logs/.gitkeep
!logs/README.md

