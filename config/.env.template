# Configuración de Jira
# Copia este archivo a .env en la raíz del proyecto y configura tus credenciales

# Credenciales de Jira (REQUERIDO)
USUARIO=tu_usuario_jira
PASS=tu_password_jira

# Alternativamente puedes usar:
# JIRA_USER=tu_usuario_jira
# JIRA_PASSWORD=tu_password_jira

# Configuración del servidor Jira (OPCIONAL)
JIRA_HOST=https://jira.si.orange.es
JIRA_TIMEOUT=30
JIRA_MAX_RESULTS=100

# Verificación SSL (OPCIONAL)
# Usa "false" solo para desarrollo/testing con certificados auto-firmados
JIRA_VERIFY_SSL=true
