# Configuración del proyecto Informe Jira Python
# Copia este archivo como .env y completa con tus credenciales

# Credenciales de Jira
USUARIO=tu_usuario_jira
PASS=tu_password_jira

# Opcional: URL del servidor Jira (si es diferente al por defecto)
# JIRA_HOST=https://jira.tu-empresa.com

# SSL: Usar False si el servidor Jira tiene certificado auto-firmado
# IMPORTANTE: Solo usar en desarrollo/testing, nunca en producción
JIRA_VERIFY_SSL=false
